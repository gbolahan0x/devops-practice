#!/bin/bash


#  Development Envirnoment Variables
#  Used for local testing and development



# Database 
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=dev_user
DATABASE_PASSWORD=dev_password
DATABASE_NAME=myapp_dev


# API Configuration
API_HOST=localhost
API_PORT=3000
API_ENDPOINT=http://localhost:3000

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text


# Features
ENABLE_CACHING=false
ENABLE_PROFILING=true
DEBUG_MODE=true

# Security
SSL_ENABLED=false
CORS_ALLOWED_ORIGINS=*

# Timeouts
DATABASE_TIMEOUT=5
API_TIMEOUT=10
