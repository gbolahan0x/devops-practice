#!/bin/bash

# Production Environment Variables
# Used for live production systems


# Database 
DATABASE_HOST=prod-db.aws.amazon.com
DATABASE_PORT=5432
DATABASE_USER=prod_user
DATABASE_PASSWORD=prod_password_super_secure
DATABASE_NAME:myapp_prod


# API Configuration
API_HOST=api.company.com
API_PORT=443
API_ENDPOINT=https://api.company.com

# logging
LOG_LEVEL=ERROR
LOG_FORMAT=json



# Features
ENABLE_CACHING=true
ENABLE_PROFILING=false
DEBUG_MODE=false


# Security
SSL_ENABLED=true
CORS_ALLOWED_ORIGINS=https://www.company.com,https://app.company.com

# Timeouts
DATABASE_TIMEOUT=30
API_TIMEOUT=60
