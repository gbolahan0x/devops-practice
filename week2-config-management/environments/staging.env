#!/bin/bash

# Staging Environment Variables
# Used for pre-production testing

# Database
DATABASE_HOST=staging-db.internal
DATABASE_PORT=5432
DATABASE_USER=staging_user
DATABASE_PASSWORD=staging_password_secure
DATABASE_NAME=myapp_staging


# API configuration
API_HOST=staging-api.company.com
API_PORT=443
API_ENDPOINT=https://staging-api.company.com

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# features
ENABLE_CACHING=true
ENABLE_PROFILING=false
DEBUG_MODE=false

# Security
SSL_ENALBLED=true
CORS_ALLOWED_ORIGINS=https://staging.company.com

# Timeouts
DATABASE_TIMEOUT=10
API_TIMEOUT=30
