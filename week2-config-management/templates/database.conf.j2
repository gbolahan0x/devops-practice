# Database Configuration
# Environment: {{ ENVIRONMENT }}

[database]
host = {{ DATABASE_HOST }}
port = {{ DATABASE_PORT }}
user = {{ DATABASE_USER }}
password = {{ DATABASE_PASSWORD }}
dbname = {{ DATABASE_NAME }}

[connection]
timeout = {{ DATABASE_TIMEOUT }}
ssl = {{ SSL_ENABLED }}
application_name = myapp-{{ ENVIRONMENT }}

[pool]
min_size = 2
max_size = 20
idle_timeout = 300

[logging]
level = {{ LOG_LEVEL }}
slow_query_threshold = 1000
