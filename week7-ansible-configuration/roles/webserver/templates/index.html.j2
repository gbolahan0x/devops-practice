<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ inventory_hostname }} | Week 7 Ansible Lab</title>
  <style>
    body {
      max-width: 760px;
      margin: 4rem auto;
      padding: 0 1.5rem;
      font-family: system-ui, sans-serif;
      line-height: 1.6;
      color: #172033;
    }

    .card {
      padding: 2rem;
      border: 2px solid #2f6feb;
      border-radius: 16px;
      background: #f6f8fa;
    }

    code {
      color: #0969da;
    }
  </style>
</head>
<body>
  <main class="card">
    <h1>Week 7: Ansible Configuration Management</h1>

    <p>{{ welcome_message }}</p>

    <ul>
      <li>Host: <code>{{ inventory_hostname }}</code></li>
      <li>Role: <code>{{ server_role }}</code></li>
      <li>Environment: <code>{{ environment_name }}</code></li>
      <li>Project: <code>{{ project_name }}</code></li>
    </ul>

    <p>This page was generated from a Jinja2 template.</p>
  </main>
</body>
</html>
